# Firebase web config for the client (values live in the Netlify site env vars).
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=

# Set to 1 to point the client at the local Firebase emulators
# (Firestore :8080, Functions :5001, Auth :9099 - start them from Server/ with
# `firebase emulators:start --only auth,firestore,functions`).
# Leave unset to talk to the real Firebase project, so you can log in with a real account.
VITE_USE_FIREBASE_EMULATORS=
